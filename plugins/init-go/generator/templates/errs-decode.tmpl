package errs

import (
	"encoding/json"
)

type rpcError struct {
	Error   `json:"data,inline"`
	Code    int    `json:"code"`
	Message string `json:"message"`
}

func Decoder(errData json.RawMessage) (err error) {

	var srcErr rpcError
	if err = json.Unmarshal(errData, &srcErr); err != nil {
		return Internal.SetCauseRaw(string(errData))
	}
	return makeError(srcErr.Message, srcErr.TrKey, srcErr.Code).SetCauseRaw(srcErr.Cause)
}
