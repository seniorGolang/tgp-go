package srvctx

import (
	"reflect"
	"sync"
)

var (
	keyMu    sync.RWMutex
	keyCache = make(map[reflect.Type]string)
)

func cachedKey(rt reflect.Type) (s string) {

	var ok bool
	keyMu.RLock()
	s, ok = keyCache[rt]
	keyMu.RUnlock()
	if ok {
		return
	}
	s = rt.String()
	keyMu.Lock()
	keyCache[rt] = s
	keyMu.Unlock()
	return
}
