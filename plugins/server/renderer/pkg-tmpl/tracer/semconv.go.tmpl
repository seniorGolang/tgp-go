package tracer

import (
	"github.com/gofiber/fiber/v2"
	"go.opentelemetry.io/otel/attribute"
	semconv "go.opentelemetry.io/otel/semconv/v1.38.0"
)

const maxTraceAttrLength = 512

func clipAttr(value string) (out string) {

	if len(value) <= maxTraceAttrLength {
		return value
	}
	return value[:maxTraceAttrLength]
}

func httpServerMetricAttributesFromRequest(c *fiber.Ctx, cfg config) (out []attribute.KeyValue) {

	flavor := "1.0"
	if c.Request().Header.IsHTTP11() {
		flavor = "1.1"
	}
	out = []attribute.KeyValue{
		semconv.HTTPRequestMethodKey.String(c.Method()),
		semconv.NetworkProtocolVersion(flavor),
		semconv.URLScheme(c.Protocol()),
	}
	if cfg.Port != nil {
		out = append(out, semconv.ServerPort(*cfg.Port))
	}
	if cfg.ServerName != nil {
		out = append(out, semconv.ServerAddress(*cfg.ServerName))
	}
	if cfg.CustomMetricAttributes != nil {
		out = append(out, cfg.CustomMetricAttributes(c)...)
	}
	return
}

func httpServerTraceAttributesFromRequest(c *fiber.Ctx, cfg config) (out []attribute.KeyValue) {

	out = []attribute.KeyValue{
		semconv.HTTPRequestMethodKey.String(c.Method()),
		semconv.URLScheme(c.Protocol()),
		semconv.URLPath(clipAttr(c.Path())),
		semconv.URLFull(clipAttr(c.OriginalURL())),
		semconv.UserAgentOriginal(clipAttr(c.Get(fiber.HeaderUserAgent))),
		semconv.HostName(clipAttr(c.Hostname())),
	}
	if cfg.collectClientIP {
		clientIP := c.IP()
		if len(clientIP) > 0 {
			out = append(out, semconv.ClientAddress(clientIP))
		}
	}
	return
}
