package token

import (
	"context"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"net/url"
	"strings"
	"time"

	"golang.org/x/oauth2"
)

type jwtBearer struct {
	tokenURL  string
	assertion Assertion
	assertTTL time.Duration
}

func JWTBearer(tokenURL string, assertion Assertion, opts ...Option) (src oauth2.TokenSource, err error) {

	tokenURL = strings.TrimSpace(tokenURL)
	assertion.Subject = strings.TrimSpace(assertion.Subject)
	assertion.KeyID = strings.TrimSpace(assertion.KeyID)
	if tokenURL == "" {
		err = fmt.Errorf("token: tokenURL is empty")
		return
	}
	if assertion.Subject == "" || assertion.KeyID == "" || assertion.PrivateKey == "" {
		err = fmt.Errorf("token: assertion is incomplete")
		return
	}
	if _, _, err = parsePrivateKey(assertion.PrivateKey); err != nil {
		return
	}

	cfg := applyOptions(opts)
	src = wrapReuse(&jwtBearer{
		tokenURL:  tokenURL,
		assertion: assertion,
		assertTTL: cfg.assertTTL,
	}, cfg)
	return
}

func (src *jwtBearer) Token() (token *oauth2.Token, err error) {

	return src.TokenContext(context.Background())
}

func (src *jwtBearer) TokenContext(ctx context.Context) (token *oauth2.Token, err error) {

	var assertion string
	if assertion, err = signAssertion(src.assertion, src.assertTTL); err != nil {
		return
	}

	form := url.Values{}
	form.Set("grant_type", grantJWTBearer)
	form.Set("assertion", assertion)
	return fetchToken(ctx, src.tokenURL, form)
}

func fetchToken(ctx context.Context, tokenURL string, form url.Values) (token *oauth2.Token, err error) {

	client := oauth2.NewClient(ctx, nil)
	var resp *http.Response
	if resp, err = client.PostForm(tokenURL, form); err != nil {
		err = fmt.Errorf("token: fetch: %w", err)
		return
	}
	defer func() { _ = resp.Body.Close() }()

	var body []byte
	if body, err = io.ReadAll(io.LimitReader(resp.Body, 1<<20)); err != nil {
		err = fmt.Errorf("token: read response: %w", err)
		return
	}
	if resp.StatusCode < 200 || resp.StatusCode > 299 {
		err = &oauth2.RetrieveError{Response: resp, Body: body}
		return
	}

	var payload struct {
		TokenType   string `json:"token_type"`
		AccessToken string `json:"access_token"`
		ExpiresIn   int64  `json:"expires_in"`
	}
	if err = json.Unmarshal(body, &payload); err != nil {
		err = fmt.Errorf("token: decode response: %w", err)
		return
	}
	if payload.AccessToken == "" {
		err = fmt.Errorf("token: empty access_token")
		return
	}

	token = &oauth2.Token{
		TokenType:   payload.TokenType,
		AccessToken: payload.AccessToken,
	}
	if payload.ExpiresIn > 0 {
		token.Expiry = time.Now().Add(time.Duration(payload.ExpiresIn) * time.Second)
	}
	return
}
