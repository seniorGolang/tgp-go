package token

import (
	"context"
	"errors"
	"io"
	"math/rand/v2"
	"net"
	"net/http"
	"strconv"
	"strings"
	"time"

	"golang.org/x/oauth2"
)

const (
	defaultMaxAttempts = 5
	defaultBackoffBase = 50 * time.Millisecond
	defaultBackoffCap  = 2 * time.Second
	defaultFlightTimeout = 30 * time.Second
)

type retryConfig struct {
	maxAttempts int
	base        time.Duration
	cap         time.Duration
	flightTimeout time.Duration
}

func defaultRetry() (cfg retryConfig) {

	return retryConfig{
		maxAttempts: defaultMaxAttempts,
		base:        defaultBackoffBase,
		cap:         defaultBackoffCap,
		flightTimeout: defaultFlightTimeout,
	}
}

// RetryOption настраивает progressive retry получения токена (IdP / metadata).
type RetryOption func(cfg *retryConfig)

// MaxAttempts задаёт число попыток IdP-операции, включая первую.
func MaxAttempts(n int) (opt RetryOption) {

	return func(cfg *retryConfig) {
		if n >= 1 {
			cfg.maxAttempts = n
		}
	}
}

// Backoff задаёт базовую и максимальную задержку между попытками IdP.
func Backoff(base time.Duration, cap time.Duration) (opt RetryOption) {

	return func(cfg *retryConfig) {
		if base > 0 {
			cfg.base = base
		}
		if cap > 0 {
			cfg.cap = cap
		}
	}
}

// Disabled отключает повторные попытки IdP (ровно одна попытка).
func Disabled() (opt RetryOption) {

	return func(cfg *retryConfig) {
		cfg.maxAttempts = 1
	}
}

// FlightTimeout ограничивает длительность общего получения источника токена.
func FlightTimeout(timeout time.Duration) (opt RetryOption) {

	return func(cfg *retryConfig) {
		if timeout > 0 {
			cfg.flightTimeout = timeout
		}
	}
}

func applyRetryOptions(opts []RetryOption) (cfg retryConfig) {

	cfg = defaultRetry()
	for _, opt := range opts {
		if opt != nil {
			opt(&cfg)
		}
	}
	if cfg.maxAttempts < 1 {
		cfg.maxAttempts = 1
	}
	if cfg.cap < cfg.base {
		cfg.cap = cfg.base
	}
	return cfg
}

func (c retryConfig) do(ctx context.Context, op func() error) (err error) {

	for attempt := 0; attempt < c.maxAttempts; attempt++ {
		if err = ctx.Err(); err != nil {
			return err
		}
		if err = op(); err == nil {
			return nil
		}
		if !isTransient(err) || attempt+1 >= c.maxAttempts {
			return err
		}
		if err = sleepCtx(ctx, backoff(c, attempt, retryAfterFrom(err))); err != nil {
			return err
		}
	}
	return err
}

type outcome int

const (
	outcomeOther outcome = iota
	outcomeAuthChallenge
	outcomeAuthDeny
)

func classifyStatus(status int) (result outcome) {

	switch status {
	case http.StatusUnauthorized:
		return outcomeAuthChallenge
	case http.StatusForbidden:
		return outcomeAuthDeny
	default:
		return outcomeOther
	}
}

func isTransient(err error) (ok bool) {

	if err == nil {
		return false
	}
	if errors.Is(err, context.Canceled) {
		return false
	}
	var re *oauth2.RetrieveError
	if errors.As(err, &re) && re.Response != nil {
		code := re.Response.StatusCode
		return code == http.StatusTooManyRequests || code >= 500
	}
	var netErr net.Error
	if errors.As(err, &netErr) {
		return netErr.Timeout() || netErr.Temporary()
	}
	msg := err.Error()
	return strings.Contains(msg, "metadata status 5") || strings.Contains(msg, "metadata status 429")
}

func retryAfterFrom(err error) (header string) {

	var re *oauth2.RetrieveError
	if errors.As(err, &re) && re.Response != nil {
		return re.Response.Header.Get("Retry-After")
	}
	return ""
}

func retryAfter(header string) (d time.Duration) {

	header = strings.TrimSpace(header)
	if header == "" {
		return 0
	}
	if secs, err := strconv.Atoi(header); err == nil && secs > 0 {
		return time.Duration(secs) * time.Second
	}
	if when, err := http.ParseTime(header); err == nil {
		if wait := time.Until(when); wait > 0 {
			return wait
		}
	}
	return 0
}

func backoff(cfg retryConfig, attempt int, retryAfterHdr string) (d time.Duration) {

	if d = retryAfter(retryAfterHdr); d > 0 {
		return d
	}
	max := cfg.base << attempt
	if max > cfg.cap || max < cfg.base {
		max = cfg.cap
	}
	return time.Duration(rand.Int64N(int64(max) + 1))
}

func sleepCtx(ctx context.Context, d time.Duration) (err error) {

	if d <= 0 {
		return
	}
	timer := time.NewTimer(d)
	defer timer.Stop()
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-timer.C:
		return
	}
}

func drainBody(resp *http.Response) {

	if resp == nil || resp.Body == nil {
		return
	}
	_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 1<<20))
	_ = resp.Body.Close()
}
