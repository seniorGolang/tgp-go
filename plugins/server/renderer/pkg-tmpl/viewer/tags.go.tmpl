package viewer

import (
	"strings"
)

const (
	tagName = "dumper"
	tagHide = "hide"
)

func tagToOption(tag string) (opt option) {

	tag = strings.TrimSpace(tag)
	if tag == "" {
		return
	}
	parsed := strings.SplitN(tag, ",", 2)
	if strings.TrimSpace(parsed[0]) != tagHide {
		return
	}
	if len(parsed) == 1 {
		return hide("-")
	}
	formula := strings.TrimSpace(parsed[1])
	if formula == "" || formula == "-" {
		return hide("-")
	}
	return hide(formula)
}
