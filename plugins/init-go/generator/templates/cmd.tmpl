package main

import (
	"context"
	"os/signal"
	"syscall"

	_ "github.com/KimMachineGun/automemlimit"
	"github.com/rs/zerolog/log"

	"{{.Module}}/internal/config"
{{range .ServicePackages}}
	"{{$.Module}}/internal/services/{{.FileBase}}"
{{end}}
	"{{.Module}}/internal/transport"
	"{{.Module}}/internal/transport/logger"
	"{{.Module}}/pkg/errs"
)

const (
	serviceName     = "{{.ServiceName}}"
	headerRequestID = "X-Request-Id"
)

var version = "local"

func main() {

	cfg := config.Service()
	log.Logger = cfg.Logger().With().
		Str("version", version).
		Str("service", serviceName).
		Logger()
	ctx, stop := signal.NotifyContext(log.Logger.WithContext(context.Background()), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	serverLogger := logger.NewZerolog(log.Logger)

	log.Ctx(ctx).Info().Msg("start service")
	defer log.Info().Msg("shutdown service")

	livenessSrv := transport.ServeHealth(serverLogger, "/liveness", cfg.LivenessBind)
	defer livenessSrv.Stop()

{{ range .ServicePackages}}
	svc{{.PublicName}} := {{.FileBase}}.New()
{{- end}}

	services := []transport.Option{
		transport.WithRequestID(headerRequestID),
{{- range .ServicePackages}}
		transport.{{.PublicName}}(svc{{.PublicName}}),
{{- end}}
	}

	srv := transport.New(serverLogger, services...).WithLog().WithMetrics()
	srv.ServeMetrics(serverLogger, "/", cfg.MetricsBind)
	defer func() {
		if shutdownErr := srv.ShutdownWithTimeout(cfg.ShutdownTimeout); shutdownErr != nil {
			log.Error().Err(shutdownErr).Msg("shutdown error")
		}
	}()

	go func() {
		log.Info().Str("bind", cfg.Bind).Msg("listen on")
		if listenErr := srv.Fiber().Listen(cfg.Bind); listenErr != nil {
			errs.PanicOnError(ctx, listenErr, "server listen error")
		}
	}()

	readinessSrv := transport.ServeHealth(serverLogger, "/readiness", cfg.ReadinessBind)
	defer readinessSrv.Stop()

	<-ctx.Done()
	stop()
}
